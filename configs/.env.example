# ha-mcp Environment Variables Example
# Copy this file to .env and adjust values
# Or export these variables in your shell

# Home Assistant URL (required)
# Examples:
#   - http://homeassistant.local:8123
#   - http://192.168.1.100:8123
#   - https://your-ha-domain.duckdns.org
HA_URL=http://homeassistant.local:8123

# Home Assistant Long-Lived Access Token (OPTIONAL)
# Generate at: Home Assistant → Profile → Long-Lived Access Tokens
#
# Authentication options:
# 1. Per-request (recommended): MCP clients send token via Authorization header
#    Comment out HA_TOKEN - each client provides their own token.
#
# 2. Default token (development): Set HA_TOKEN for backwards compatibility.
#    Requests without Authorization header will use this token.
#
# If set, keep this secret! Do not commit to version control.
# HA_TOKEN=your-long-lived-access-token

# MCP Server Port (optional, default: 8080)
HA_MCP_PORT=8080

# Log Level (optional, default: INFO)
# Available levels: TRACE, DEBUG, INFO, WARN, ERROR
# TRACE: Full request/response bodies (very verbose)
# DEBUG: Detailed debugging information
# INFO:  General operational information (default)
# WARN:  Warnings only
# ERROR: Errors only
HA_MCP_LOG_LEVEL=INFO

# ============================================================================
# Tool Filtering & Access Control
# ============================================================================
# Read-only mode: blocks all write operations (default: false)
# Convenience flag equivalent to: HA_MCP_TOOL_FILTER_BLACKLIST="*:write"
# HA_MCP_READ_ONLY=false

# Tool filter whitelist (comma-separated, default: empty)
# If non-empty, ONLY these tools/actions are allowed
# Examples:
#   HA_MCP_TOOL_FILTER_WHITELIST="get_state,manage_automation:list,manage_automation:get"
#   HA_MCP_TOOL_FILTER_WHITELIST="get_*"
# HA_MCP_TOOL_FILTER_WHITELIST=

# Tool filter blacklist (comma-separated, default: empty)
# Block specific tools/actions (only if whitelist is empty)
# Examples:
#   HA_MCP_TOOL_FILTER_BLACKLIST="call_service,manage_automation:delete"
#   HA_MCP_TOOL_FILTER_BLACKLIST="manage_*:delete"
#   HA_MCP_TOOL_FILTER_BLACKLIST="*:write"
# HA_MCP_TOOL_FILTER_BLACKLIST=

# ============================================================================
# REST API Settings
# ============================================================================
# Rate limiting for REST API requests
# HA_REST_RATE_LIMIT=10
# HA_REST_RATE_BURST=5

# Retry settings for transient failures. GET/HEAD requests retry on 429,
# 500/502/503/504 and network errors (not client timeouts); other methods
# (create/update/delete, flow steps, template render) retry only on 429 and
# connection-setup (dial) failures, because replaying them after a 5xx or
# timeout could run a write twice.
# Max retry attempts (0 = no retries, default: 3)
# HA_REST_MAX_RETRIES=3
# Initial delay between retries in milliseconds (default: 100)
# A delay of 0 or less falls back to the default
# HA_REST_RETRY_INITIAL_DELAY_MS=100
# Maximum delay between retries in milliseconds (default: 5000)
# A value below the initial delay is raised to the initial delay
# HA_REST_RETRY_MAX_DELAY_MS=5000

# ============================================================================
# WebSocket Settings
# ============================================================================
# Retry settings for transient command failures (bound the retries of a single command)
# Max retry attempts (0 = no retries, default: 3)
# HA_WS_MAX_RETRIES=3
# Initial delay between retries in milliseconds (default: 100)
# A delay of 0 or less falls back to the default
# HA_WS_RETRY_INITIAL_DELAY_MS=100
# Maximum delay between retries in milliseconds (default: 5000)
# A value below the initial delay is raised to the initial delay
# HA_WS_RETRY_MAX_DELAY_MS=5000

# ============================================================================
# MCP Client Authentication
# ============================================================================
# MCP clients should send the Home Assistant token in the Authorization header:
#
#   Authorization: Bearer <your-ha-access-token>
#
# Example MCP client configuration (Claude Desktop):
#   {
#     "mcpServers": {
#       "homeassistant": {
#         "type": "http",
#         "url": "http://localhost:8080",
#         "headers": {
#           "Authorization": "Bearer ${HA_TOKEN}"
#         }
#       }
#     }
#   }
#
# Example MCP client configuration (Cline):
#   {
#     "servers": {
#       "ha-mcp": {
#         "url": "http://localhost:8080",
#         "headers": {
#           "Authorization": "Bearer your-ha-access-token"
#         }
#       }
#     }
#   }
